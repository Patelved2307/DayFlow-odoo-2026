# ==========================================================
# NexaWork / DayFlow Environment Configuration Example
# Copy this file to `.env` in the root folder and fill in your keys.
# ==========================================================

# 1. Supabase Database API Credentials (Project Settings -> API)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# 2. Backend Express Server Port
PORT=3001

# 3. Nodemailer Real SMTP Email Dispatch (Optional for Production Inbox Delivery)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# 4. App & AI Credentials
GEMINI_API_KEY=""
APP_URL="http://localhost:3000"
